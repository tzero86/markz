{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkZ",
  "version": "0.5.1",
  "identifier": "dev.markz.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MarkZ",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default capabilities for MarkZ",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "dialog:default",
            "updater:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4RjU1MDc4QkY0MURGOUMKUldTYzMwRy9lRkQxcUpBNk9Ec3ppN1dQU1VkNitOQ2lJcWx6UnMvM0liR25QVkNIL2hSZDFOaHIK",
      "endpoints": [
        "https://github.com/tzero86/markz/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
